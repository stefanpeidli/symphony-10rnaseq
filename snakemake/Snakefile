### CONFIGURATION ###
from snakemake.utils import min_version
min_version("8.0.0")  # set minimum snakemake version, not tested with older versions, change at your own risk
configfile: "../configuration/config.yaml"
conda: "../environments/snake_env.yaml"

### MODULES ###
import pandas as pd
import numpy as np
from tqdm import tqdm
from pathlib import Path

### PATHS and Names ###
DIR = Path(config['DIR'])
BASEDIR = Path(workflow.basedir)  # get the directory of the Snakefile
SAMPLES = [line.strip() for line in open(BASEDIR / "../resources/sample_list.txt", encoding="utf-8")
           if line.strip() and not line.lstrip().startswith("#")]
PERTURBATIONS = config['perturbations']
PERTURBATIONS_targeting = [p for p in PERTURBATIONS if p != 'NT']
CELL_LINES = config['cell_lines']

### RULES ###
rule all:
    input:
        BASEDIR / "../results/count_matrix_vst.csv",
        expand(BASEDIR / "../results/deseq2/{cell_line}/{perturbation}_deseq2_results.csv", cell_line=CELL_LINES, perturbation=PERTURBATIONS_targeting),

rule collect_data:
    input:
        in_dir=DIR / "raw_counts/"
    output:
        counts=BASEDIR / "../results/count_matrix.tsv",
        coldata=BASEDIR / "../results/coldata.tsv",
    run:
        tabs = {}
        for sample in tqdm(SAMPLES):
            d = Path(input.in_dir) / f'{sample}/RNA/counts/'
            if d.exists():
                tab = pd.read_csv(d / f"{sample}.converted_counts.tsv.gz", compression='gzip', sep='\t', header=0, skiprows=6, index_col=(0,1,2,3,4))
                tabs[sample] = tab['count']
        df = pd.concat(tabs, axis=1)
        df = df[~df.index.get_level_values(1).duplicated(keep='first')]  # remove duplicated gene names
        df.to_csv(output.counts, sep='\t', header=True)

        line = ['H1299' if k=='99' else 'H1975' if k=='75' else 'Unknown' for k in df.columns.str[:2]]  # TODO: verify this!
        genotype = list(df.columns.str.split('_').str[0].str[2:])
        perturbation = list(df.columns.str.split('_').str[1])
        guide = list(df.columns.str.split('_').str[2])  # TODO: verify this!
        replicate = list(df.columns.str.split('_').str[3])  # TODO: verify this!

        coldata = pd.DataFrame({
            "line": line,
            "genotype": genotype,
            "perturbation": perturbation,
            "guide": guide,
            "replicate": replicate
        }, index=df.columns)
        # Cleanup
        for index, row in coldata[~coldata.index.str.contains('_V')].iterrows():
            coldata.loc[index, 'guide'] = row.perturbation[-1] if 'MOCK' not in index else None
            coldata.loc[index, 'perturbation'] = row.perturbation[:-1].upper() if 'MOCK' not in index else 'MOCK'
            coldata.loc[index, 'replicate'] = row.guide
        coldata.loc[coldata.perturbation == 'MOC', 'perturbation'] = 'MOCK'
        coldata.loc[coldata.perturbation == 'PP', 'guide'] = coldata.loc[coldata.perturbation == 'PP', 'replicate']
        coldata.loc[coldata.perturbation == 'PP', 'replicate'] = coldata.loc[coldata.perturbation == 'PP'].index.str.split('_').str[-1]
        coldata.loc[coldata.perturbation == 'PP', 'perturbation'] = 'PPIA'
        coldata.loc[coldata.perturbation == 'MALAT', 'perturbation'] = 'MALAT1'
        coldata.loc[coldata.perturbation == 'NEAT', 'perturbation'] = 'NEAT1'
        coldata.loc[coldata.perturbation == 'MOCK', 'guide'] = None
        coldata.loc[:, 'guide'] = coldata.loc[:, 'guide'].str.replace('V', '', regex=False)

        coldata.to_csv(output.coldata, sep='\t', header=True)

rule vst_normalization:
    input:
        counts=BASEDIR / "../results/count_matrix.tsv",
        coldata=BASEDIR / "../results/coldata.tsv",
    output:
        vst_counts=BASEDIR / "../results/count_matrix_vst.csv",
    resources:
        mem_mb=64000,
        runtime=60,
    container:
        "docker://quay.io/biocontainers/bioconductor-deseq2:1.46.0--r44he5774e6_1"
    script: 
        BASEDIR / "scripts/snake_vst.R"

rule run_deseq2:
    input:
        counts=BASEDIR / "../results/count_matrix.tsv",
        coldata=BASEDIR / "../results/coldata.tsv",
    output:
        deseq2_results=BASEDIR / "../results/deseq2/{cell_line}/{perturbation}_deseq2_results.csv",
    resources:
        mem_mb=64000,
        runtime=60,
    container:
        "docker://quay.io/biocontainers/bioconductor-deseq2:1.46.0--r44he5774e6_1"
    script:
        BASEDIR / "scripts/snake_run_deseq2.R"